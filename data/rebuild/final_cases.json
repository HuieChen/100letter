    {
      "id": "case05",
      "title": "Desk B",
      "type": "internal_staff_paper",
      "initial_envelope_state": "intact",
      "legal_dispositions": [
        "file_officially",
        "keep_at_desk",
        "supervisor_next_shift"
      ],
      "optional_open": false,
      "deadline": null,
      "recipient_id": "next_local_exceptions_clerk",
      "sender_id": "helena_voss",
      "envelope": {
        "recipient": "The next person assigned to Local Exceptions, Desk B",
        "sender": "Helena Voss",
        "date": "2020-07-20",
        "status": "internal staff paper"
      },
      "body": "If you are reading this, someone finally opened the bottom ledger pocket.\n\nI used Desk B for eleven years. Most unresolved letters were boring: old addresses, bad handwriting, people who moved without telling anyone.\n\nA few were not boring.\n\nThere were three times I held a letter after I already knew where it belonged.\nI told myself I was buying time. Once I was right. Once I still do not know. Once I am fairly sure I made another person’s decision for them because I was afraid of what would happen if I did my job.\n\nThe marks in the ledger are mine. They are not procedure.\n\nIf you find the remaining letters, do not treat my choices as instructions.\nAnd do not assume that delivering everything automatically makes you innocent either.\n\n— Helena Voss",
      "body_source": "04_VERTICAL_SLICE/CASE_BIBLE_FINAL.md",
      "private": false,
      "clues": [
        "ledger_hv_repeat",
        "helena_rota",
