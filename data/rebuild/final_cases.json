    {
      "id": "case02",
      "title": "Before the Last Shuttle",
      "type": "local_priority_hand_delivery",
      "initial_envelope_state": "intact",
      "legal_dispositions": [
        "deliver",
        "delegate",
        "hold_for_verification",
        "unresolved_with_note"
      ],
      "optional_open": true,
      "deadline": "17:30",
      "recipient_id": "mira_vale",
      "sender_id": "",
      "envelope": {
        "recipient": "Mira Vale",
        "service_mark": "LOCAL PRIORITY — HAND TO RECIPIENT",
        "counter_note": "Before 17:30 if possible",
        "return": ""
      },
      "body": "Mira,\n\nI kept the second ticket.\n\nI know that sounds dramatic. It is not meant to be. If you still want to leave tonight, leave. I am not asking you to stay because I am afraid of what happens after you go.\n\nBut before the last shuttle, come up to the lookout. I want to give you the ticket myself, and I want one conversation where neither of us pretends we are being practical.\n\n— J.",
